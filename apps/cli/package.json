    "@devtools/tool-jwt": "workspace:*",
    "@devtools/tool-color": "workspace:*",
    "@devtools/tool-regex": "workspace:*",
    "@devtools/tool-cron": "workspace:*",
    "@devtools/tool-case": "workspace:*",
    "@devtools/tool-password": "workspace:*",
    "@devtools/tool-qr": "workspace:*",
    "@devtools/tool-diff": "workspace:*",
    "@devtools/tool-lorem": "workspace:*",
    "@devtools/tool-url": "workspace:*",
    "@devtools/tool-yaml": "workspace:*",
